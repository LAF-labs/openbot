{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAF Agent",
  "version": "0.2.0",
  "identifier": "com.lafco.lafagent",
  "build": {
    "frontendDist": "../public",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LAF Agent",
        "url": "https://agent.laf-co.com",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "zoomHotkeysEnabled": false,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-YL07XlA7vKD83TlUUsXTQ447ZwDLPX4MT8w81KA2Z80='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://agent.laf-co.com https://*.agent.laf-co.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lafagent"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFOUE0MjM1RkVDN0Q1MzUKUldRMTFjZitOVUthUHQxSjVrWlFCekRiN00zakl5WnR1KzdNWDFoYkhLZHkwWTVOUXdETk4zWDEK",
      "endpoints": ["https://agent.laf-co.com/desktop/latest.json"]
    }
  }
}
