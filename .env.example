DATABASE_URL=postgres://openbot:openbot@localhost:5432/openbot
# Compose only, and only for the database it starts: docker-compose.yml builds the server's and the
# migration's DATABASE_URL from this, so the two halves cannot drift. Unset it is `openbot`, which
# is what every deployment made before this line existed already has — the password lives in the
# postgres volume once that volume exists, so changing this afterwards is an `ALTER USER` inside the
# running database, not an edit here. The line above is the one local development reads.
# POSTGRES_PASSWORD=openbot
# Credential vault encryption key. The example value is public and only suitable for local
# development. Production refuses to start with this key.
#   openssl rand -base64 32
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PORT=3001
TENANT_PACKAGE_DIR=../tenant/laf
# Sign-in. Leave commented for local development with LAF_DEV_NO_AUTH; a deployment declares
# its providers in AUTH_PROVIDERS and supplies the matching credentials — the server refuses to
# start if the declaration and the credentials disagree, because the sign-in buttons are compiled
# from the declaration and the two halves must not drift.
#
# Redirect URI to register, per provider: {PUBLIC_ORIGIN}/api/auth/callback/<provider>
#   google  console.cloud.google.com        …/callback/google
#   kakao   developers.kakao.com            …/callback/kakao  — 카카오 로그인 동의항목에서
#           '카카오계정(이메일)'을 켜야 한다. 이메일 없이는 계정을 만들 수 없다.
#   naver   developers.naver.com            …/callback/naver  — 이메일 제공 동의 필수
#
# BETTER_AUTH_SECRET must be a high-entropy secret of at least 32 characters. Generate one:
#   openssl rand -base64 32
# TRUSTED_ORIGINS is where the app is served from, which is port 3010 locally.
# AUTH_PROVIDERS=google,kakao,naver
# BETTER_AUTH_URL is also the origin OAuth연결 (Notion, Google Drive) sends people back to after a
# vendor consent — /api/plugins/oauth/callback lives under it. No extra setting: the one public URL
# a deployment already declares is the one the vendors are told.
# BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# KAKAO_OAUTH_CLIENT_ID=
# KAKAO_OAUTH_CLIENT_SECRET=
# NAVER_OAUTH_CLIENT_ID=
# NAVER_OAUTH_CLIENT_SECRET=

# Or sign in through the fleet's broker instead of direct apps: AUTH_PROVIDERS=laf
# with the broker's issuer and this deployment's PUBLIC client id (no secret —
# PKCE carries the proof; the id is issued at provision).
#
# The client id is this deployment's own fqdn, `<slug>.agent.laf-co.com`. The slug is the random
# ten-character one the control plane mints, not the store's name: copying the name in produces an
# id no broker has ever heard of, and the failure arrives at somebody's first sign-in rather than
# at startup. Take the value the provisioner gave you verbatim.
# LAF_OIDC_ISSUER=https://auth.agent.laf-co.com
# LAF_OIDC_CLIENT_ID=m7k4q2xr3v.agent.laf-co.com
# INITIAL_ADMIN_EMAILS=admin@example.com
#
# Who may sign in AT ALL. Unset means anyone Google authenticates gets an account — fine on a
# laptop, wrong on a deployment: one VM belongs to one person. Set it on every deployment.
# Admin emails above are always admitted on top, so listing staff here cannot lock the owner out.
# SIGN_IN_ALLOWED_EMAILS=owner@example.com

# Local development only. This admits every request as one local administrator. Keep it explicit and
# never expose a deployment to the internet in this state; production refuses to start with it.
LAF_DEV_NO_AUTH=true
TRUSTED_ORIGINS=http://localhost:3010

# The deployed address, and the only setting `docker compose up` needs that has no sensible default.
#
# One value, three jobs: Caddy takes a certificate for it, the API issues cookies for it, and the
# installed shell has to be built pointing at it. The scheme is part of it — to a browser
# https://host and host are different origins, and a mismatch reads as a session that never sticks.
#
# Setting it is not enough on its own. The name's A record has to reach the machine, ports 80 and
# 443 have to be open in both the cloud firewall and the host's, and the shell's two values in
# desktop/src-tauri have to name the same origin. See docs/laf/deploying.md.
# PUBLIC_ORIGIN=https://example.com
# The www name, which only redirects to the apex. Set it when a www DNS record points here, or
# people who type www get a TLS error instead of the site.
# PUBLIC_WWW_ORIGIN=https://www.example.com

# How long a Bot's stream may say nothing before this deployment gives up on the turn, in
# milliseconds. A Bot is any AG-UI endpoint, which means it will be redeployed mid-answer, its own
# upstream will time out, and it will sometimes accept a connection and then write nothing at all.
# Without this the channel stays busy, the composer stays locked, and the only way out is a reload.
#
# Silence, not duration. A turn may legitimately run for an hour while events keep arriving; what is
# measured here is the gap between them. Nothing about how long a Bot is allowed to work changes.
#
# A minute, because this deadline is in a race it has to win. Every Bot in this repository serves on
# Bun with `idleTimeout: 120`, and Bun tears a wedged streaming response down at roughly a second
# past that. A watchdog set to the same two minutes lands within a second of the socket dying, and
# whichever gets there first decides what the person sees: this deployment's sentence naming the Bot
# and saying the turn was ended, or "The socket connection was closed unexpectedly" and no audit row
# at all. Half the Bot's own idle timeout is far enough clear that the answer is always the first.
#
# A minute is still far longer than any real silence inside a run. The longest legitimate one is the
# wait for a model's first token, which is seconds. Browser tool calls do not need allowing for:
# they run between turns, not during one, because the run ends before the browser executes the tool
# and a second run carries the result back.
#
# 0, or leaving this unset, switches the watchdog off. Nothing is watched and no turn is ever ended.
AGENT_STALL_TIMEOUT_MS=60000

# Where "a Bot is blocked on you" is delivered.
#
# One POST per question a boundary opens: {kind, headline, botId, approvalId, subject} as JSON,
# fire-and-forget, and a failure never fails the question. Unset, the buzz is a log line and the
# question still waits on the approvals surface — which is what every deployment got until now,
# because the server has always read this and nothing passed it through.
#
# A webhook because the AlimTalk channel is still in review. Point it at whatever reaches the phone
# in your hand today; the delivery end changes and this variable does not.
#
# It is now one door of the notification outbox rather than a call from inside the approval
# registry, so the body carries `notificationId` as well — the row it is about. Everything else
# about it is unchanged. See docs/laf/notifications.md.
# LAF_NOTIFY_WEBHOOK_URL=

# The AlimTalk door. NOTHING READS THESE YET, and that is deliberate.
#
# "봇 ○○이 승인을 기다립니다 → 링크" on the phone the shop owner actually has in their hand is the
# third leg of docs/laf/redesign-2026-09.md §5.7, and decision §7-4 defers it: a KakaoTalk business
# channel and a message template both go through a review that takes weeks and happens outside this
# repository. What exists today is the slot — one adapter, one name in `delivered_via`, and these
# five holes — and it never claims to have delivered anything, so a question that only AlimTalk
# could have carried is still visibly unanswered rather than silently "sent".
#
# Setting them changes nothing until the vendor call is written. They are here so an operator can
# see what will be needed, and so that filling them in is a five-minute job on the day it clears.
# LAF_ALIMTALK_BASE_URL=
# LAF_ALIMTALK_API_KEY=
# LAF_ALIMTALK_SENDER_KEY=
# LAF_ALIMTALK_TEMPLATE_CODE=
# LAF_ALIMTALK_TO=

# How long this deployment keeps its audit trail and its run records, in days.
#
# 365 by decision (docs/laf/redesign-2026-09.md §7-7, and docs/laf/data-lifecycle.md for what that
# means to the person whose data it is). The sweep runs a few hours after boot and every six hours
# after that, and logs one line per run including the run that removed nothing — a job that only
# speaks up when it deleted something cannot be told from a job that stopped running.
#
# 0 KEEPS EVERYTHING and switches the sweep off entirely. That is a real setting, for a deployment
# under an obligation to retain; it is not the same as leaving this unset. Anything that is not a
# whole number of days at least zero refuses to start rather than falling back to the default.
#
# The notification outbox rides the same sweep on a fixed thirty days of its own — it is a delivery
# queue, not the trail — so 0 keeps those too.
#
# Conversations are NOT covered by this. They are kept until the person deletes them or deletes
# their account — the same decision record, and the reason there is no CONVERSATION_RETENTION_DAYS.
AUDIT_RETENTION_DAYS=365

# Model key. Required: the API server and `agent-bot` both speak the OpenAI chat-completions API
# directly, whoever is serving it.
OPENAI_API_KEY=

# Where that key is spent. Unset, it is OpenAI. Set, it is any endpoint speaking the same
# `/v1/chat/completions` API: a gateway in front of several providers, a proxy, or a model on
# hardware you control. The API server and `agent-bot` both read it, so one line moves the whole
# deployment rather than one Bot.
#
# Model names travel verbatim, so use whatever the endpoint publishes. An endpoint that namespaces
# its catalogue wants both halves of the name — which is why the deployed default carries its
# vendor:
#
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=...
#   BOT_MODEL=z-ai/glm-5.3-flash
#
# OPENAI_BASE_URL=

# Which model answers, everywhere. One name, sent verbatim to OPENAI_BASE_URL: the API server reads
# it through the tenant package, `agent-bot` reads it directly, and the eval certifies whatever it
# names. There is no per-provider variable — ANTHROPIC_*, GOOGLE_* and BOT_PROVIDER used to be
# listed here and were read by nothing at all; the endpoint above decides who serves the model.
#
# THE ONE FALLBACK IS `tenant/laf/model.yaml`. Nothing else has a default: `agent-bot` refuses to
# start without this line rather than answering on a model nobody chose, and the eval refuses to
# certify one. It is shipped set because a deployment that forgets it is a deployment that does not
# start.
BOT_MODEL=z-ai/glm-5.3-flash

# The time zone the Bot is told the current time in, on every run, so "오늘 주문" means today here
# and a routine at dawn knows which day it is. IANA name; Asia/Seoul unset.
# BOT_TIME_ZONE=Asia/Seoul

# Whether that model reasons, and therefore takes an effort setting. Unset is true, which is the
# tenant package's own fallback. Set it false on a model that does not reason: nothing is sent and
# the control disappears from the Bot's profile rather than sitting there doing nothing.
# BOT_MODEL_EFFORT=true

# Which model judges a Bot's "do not ask me about" instruction. Unset, it is BOT_MODEL, which works
# and is slow: measured against the deployed model, one yes/no took between ten and thirty seconds,
# which is longer than a person often takes to press the button themselves. Point it at something
# small and fast.
# REVIEW_MODEL=

# How many Bots one person may have. Unset is 5. Counted per person, not per deployment.
# BOT_SEATS_PER_ACCOUNT=5

# The Bot computer. Absent means the feature is off and its routes are not mounted.
AGENT_COMPUTER_URL=http://localhost:4100
# Secret every computer requires from its caller. `agent-computer` drives a browser holding real
# logins, while policy, audit and sign-in live in the API server. The computer refuses to start
# without this value and refuses every request that does not present it. Use a long random value;
# `scripts/start.sh` sets a development one for you.
COMPUTER_TOKEN=
# Local only. Lets a Bot browse this machine's own services; never set this in a deployment.
AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
#
# What a Bot may do on its computer, as one JSON object. Absent uses the built-in default, which
# permits the acting tools and forbids nothing, and records every action either way.
#
# `deny` is evaluated first and beats everything. An empty `allow` permits nothing, a missing policy
# permits nothing, and a rule that fails to parse denies rather than letting the action through. The
# server refuses to start if this is set and malformed, so an invalid restriction never falls back to
# permissive behavior.
#
# `ask` is the third list, checked after `deny` and before `allow`. A match stops the Bot, puts the
# action in front of a person in the conversation, and carries on with the same action if they allow
# it, so the turn is not thrown away. Nothing an `ask` rule matches can be reached by a `deny` rule:
# forbidden stays forbidden and is never offered as a question. It has to beat `allow`, because the
# shipped default allows everything it does not name, and an ask checked afterwards would never fire.
# What it names: pressing a button whose label says money, sending, deleting or confirming (결제·송금·
# 이체·출금·구매·주문·삭제·탈퇴·전송·발송·발행·승인·확정, pay, send, delete, confirm…), pressing
# anything on a Korean bank, payment or settlement portal, the fifth identical action in a row — all
# asked; and typing into a password field, which is refused and answered with the secret-request
# tool instead. The lists live in server/src/computer/default-policy.ts; a deployment edits its saved
# policy, never that file.
#
# An answer is bound to the exact action it was given for, so allowing one button is not permission
# to press a different one, and it can only be spent once. Nobody answering within ten minutes is the
# same as nobody being asked: the action does not happen. A No sticks: the same Bot asking for the
# same action again within thirty minutes is refused without a second question.
#
# Every list judges a Bot's calls to MCP servers as well as what it does in a browser, `ask` included,
# so a rule like `intent == "write_tool" && mcp.server == "jira"` stops the call and asks rather than
# refusing it. The questions and the answers are the same three audit rows either way.
#
# Workspace and browser profile per Bot, inside ONE computer. Every Bot a person makes shares that
# person's single agent-computer container — one VM per person, see docs/laf/deployment-model.md —
# and is told apart inside it by profile directory, so the separation is an audit unit and a
# convenience, not a boundary. The boundary between two people is their two VMs. Every action
# records which Bot took it, and a rule can restrict a single Bot with `bot.id`.
#
# Attributes: tool.name, bot.id, actor.id, page.url, page.host, element.ref/role/name/type,
#             key, submit, file.path, file.name, file.extension, mcp.server/tool/effect,
#             repeat.count.
#
# repeat.count is how many times this Bot has just made this exact call, counting the one being
# decided. A stuck model retries, and each retry is a real action on somebody's live website that is
# perfectly reasonable on its own terms; only the count tells the thirtieth click apart from the
# first. `repeat.count >= 10` in `deny` stops a Bot going in circles. Two calls are the same call
# when the thing acted on is the same, whatever was typed into it, so ten searches typed into one box
# are ten repeats and a rule about repetition refuses the tenth. The count is held in memory by the
# one API process a deployment runs (docs/laf/deployment-model.md); calls to another server's tools
# over MCP are not counted yet.
#
# Name every route to the same effect. A form submits from a keypress in any of its fields, so a rule
# that only blocks a Submit button does not block Enter from another field, and a Bot can ask the type
# tool to press Enter for it, which arrives as `submit` rather than as a keypress. The example below
# names all three.
# Functions: contains(haystack, needle) and matches(value, pattern), both case-insensitive.
# Every policy enforces. There is no dry-run: a rule that decides and records but lets the action
# through is a boundary that lies, and a saved policy that still says `"mode": "dry-run"` is read
# as enforced.
#
# AGENT_COMPUTER_POLICY={"mode":"enforce","deny":["(intent == \"activate\" && contains(element.name, \"submit\")) || (tool.name == \"computer_key\" && key == \"Enter\") || submit"],"ask":["intent == \"write_file\" && !matches(file.path, \"^notes/\")"],"allow":["true"]}

# How long two identical calls count as the same repetition, in ms. Three minutes unset, which
# assumes a retry loop is a model round trip apart: call the tool, read the failure, try again.
# Widen it for a deployment whose provider is slow or heavily queued, where genuine retries arrive
# minutes apart and every attempt would otherwise be counted as the first one. Widen it too far and
# honest work starts to accumulate: a Bot told to watch a dashboard all morning reloads the same page
# and is not stuck. Anything that is not a positive whole number stops the server rather than falling
# back to the default, because a rule about repetition that never fires looks exactly like a Bot
# behaving itself.
# COMPUTER_REPEAT_WINDOW_MS=180000

# How long one action waits for its element, in ms. Read by agent-computer, not the server.
# ACTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# The computer's profile and where its traffic leaves from
# ---------------------------------------------------------------------------

# Chromium profile directory inside agent-computer, mounted from the `agent-profiles` volume in
# docker-compose.yml. Pointing it somewhere unmounted disables login persistence.
# PROFILES_DIR=/profiles

# Which Bot this computer belongs to, and therefore which profile directory it uses.
# COMPUTER_BOT_ID=shared

# Per-Bot egress identity. A proxy the Bot's browser sends everything through, so the far side sees a
# stable address it can allow-list or attribute to that Bot. `EGRESS_PROXY_<BOT>` names one Bot,
# `EGRESS_PROXY_DEFAULT` covers the rest, and absent means the browser goes out directly.
#
# Credentials may be in the URL and are split out before Playwright sees them. Only the HOST is ever
# reported back on the admin page or the API, so the password does not end up on a screen.
#
# This is attribution, not anonymity, and it is not a boundary by itself: it gives a security team a
# per-Bot address for network rules alongside AGENT_COMPUTER_POLICY.
# EGRESS_PROXY_DEFAULT=http://user:password@proxy.internal:8080
# EGRESS_PROXY_SALES_BOT=http://sales.proxy.internal:8080


# Where every Bot a person creates is answered. Required: use an HTTP(S) URL.
#
# There is one, and it is `agent-bot`. A second endpoint on :4201 used to be described here, from
# the per-Bot container plane that was removed in 2026-08. Another AG-UI service can still be added
# as a Bot of its own at /agents; this variable names the one that answers the Bots people make.
MANAGED_AGENT_AG_UI_URL=http://localhost:4200/ag-ui

