/*
 * What nothing reaches: files, exports, dependencies. Run by `tests/knip.test.ts`, so by the gate.
 *
 * WHY A TOOL AND NOT A GREP. On 2026-09-24 rooms and multi-Bot went, and the harness replaced the
 * trimming, effort and budget code. What they left behind — a room's avatar component, a hide
 * mutation, a face-seed helper, re-exports nobody imported — typechecked and passed tests, because
 * nothing that is never called can fail. knip (ISC, webpro-nl/knip) follows the import graph from
 * the entries below and names what the graph never reaches.
 *
 * Every entry is somewhere a process starts; the ones a `package.json` script already names
 * (`src/index.ts`, `src/main.tsx` through Vite, `typecheck.ts`) knip reads from there. A file only a
 * subprocess runs is an entry too, or it reads as dead: the `*-render.tsx` helpers and the
 * `*-child.ts` routine processes are spawned by `bun <path>` from a test, not imported.
 */
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export its own file uses is a local that happens to be exported; not dead.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // shadcn's generated primitives export every part; the app takes the parts it needs.
    "app/src/components/ui/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "evals/*.ts",
        "tests/**/*.test.ts",
        // The workbench service's own process: `docker-compose.yml` starts it from source, out of
        // `shared/`, so no workspace's entry reaches it.
        "shared/workbench/main.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "evals/**/*.ts",
        "tests/**/*.ts",
        "shared/**/*.ts"
      ]
    },
    "app": {
      "entry": [
        "src/routes/**/*.tsx",
        "scripts/*.ts",
        "tests/**/*.test.{ts,tsx}",
        "tests/support/*-render.tsx",
        // Loads `vite.config.ts` in a process of its own, for the same reason the renders run so.
        "tests/support/*-probe.ts"
      ],
      // The stylesheet is in the project so its `@import`s count as uses of tailwindcss and friends.
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.ts",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "server": {
      "entry": [
        "src/index.ts",
        // The attachment converter's own process: bundled as `dist/converter.js` by the Dockerfile
        // and run by the `converter` service, and the child it starts per file.
        "src/converter.ts",
        "scripts/*.ts",
        "drizzle.config.ts",
        "tests/**/*.test.ts",
        "tests/support/*-child.ts"
      ],
      // Its plugin loads the config, which refuses to load without DATABASE_URL.
      "drizzle": false,
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "agent-bot": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "agent-computer": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "desktop": {
      "entry": ["scripts/*.ts"],
      "project": ["*.ts", "scripts/**/*.ts"]
    },
    "hub": {
      "entry": ["src/index.ts", "drizzle.config.ts", "tests/**/*.test.ts"],
      // Its plugin loads the config to find the schema; the entry above already names both.
      "drizzle": false,
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
