# The deployment's front door: TLS, the built app, and the one proxy to the API.
#
# PUBLIC_ORIGIN is the address this deployment answers as, and it is the whole TLS setup. Caddy
# takes a certificate for any name here that is not localhost, which needs three things true at
# once: the name's A record reaches this machine, ports 80 and 443 are open to the internet, and
# nothing else already holds them. Miss one and Caddy retries an ACME challenge that cannot
# complete, which looks like a server that never finishes starting.
#
# It carries a scheme on purpose. The same value is the API's cookie origin, and the two must be
# the same string down to the scheme or sign-in issues a cookie the next request will not send.

{$PUBLIC_ORIGIN:http://localhost} {
	encode zstd gzip

	# Everything the API owns, including the live screen's WebSocket. `reverse_proxy` passes an
	# upgrade through without being told to; the socket arrives here as an ordinary /api path
	# because the app builds its URL from window.location rather than from a configured host.
	handle /api/* {
		reverse_proxy server:3001
	}

	# Hashed filenames, so the bytes at one of these paths never change. A year is what lets a
	# returning person load the app without asking about a single asset.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# index.html is the one file whose name never changes and whose contents always do: it is what
	# names the hashed bundles. Cached, it pins somebody to the build they first visited — measured,
	# after a deploy the browser was still running a bundle that no longer existed in the image, and
	# the new feature was simply absent with nothing on screen to say so. A shipped update that
	# reaches nobody is the worst shape of all: it looks deployed from every side except the user's.
	#
	# Written as "everything that is not an asset" rather than as a list of pages, because the SPA
	# fallback serves index.html for paths no file matches — a matcher naming `/index.html` would
	# miss every deep link, which is most of the ways anybody arrives.
	@page not path /assets/* /api/*
	header @page Cache-Control "no-cache"

	handle {
		root * /srv

		# The router runs in the browser, so a deep link asks for a path no file matches. Without
		# this line every reload anywhere but / is a 404 — and it is invisible in development,
		# where Vite does the same fallback on its own.
		try_files {path} /index.html

		file_server
	}
}

# People type www out of habit, and a name that resolves but cannot complete a TLS handshake reads
# as "the site is broken", not "use the other name" — measured as ERR_SSL_PROTOCOL_ERROR on the
# first real sign-in attempt. This block takes its own certificate and hands every request to the
# apex. A redirect rather than a second copy of the app, because the API's cookie origin is ONE
# string: an app served from two hosts is two origins to a browser, and the www copy would offer
# sign-in forever without ever holding a session.
{$PUBLIC_WWW_ORIGIN:http://www.localhost} {
	redir {$PUBLIC_ORIGIN:http://localhost}{uri} permanent
}
