# The deployment's front door: TLS, the built app, and the one proxy to the API.
#
# PUBLIC_ORIGIN is the address this deployment answers as, and it is the whole TLS setup. Caddy
# takes a certificate for any name here that is not localhost, which needs three things true at
# once: the name's A record reaches this machine, ports 80 and 443 are open to the internet, and
# nothing else already holds them. Miss one and Caddy retries an ACME challenge that cannot
# complete, which looks like a server that never finishes starting.
#
# It carries a scheme on purpose. The same value is the API's cookie origin, and the two must be
# the same string down to the scheme or sign-in issues a cookie the next request will not send.
#
# The second address is this container asking itself, for the healthcheck in docker-compose.yml and
# for nothing else. It is an ADDRESS ON THIS BLOCK rather than a block of its own so that the
# healthcheck travels the exact routes below: a rewrite that breaks /health for the internet breaks
# it for the healthcheck in the same edit. It has to be a second address at all because the first
# cannot be asked from in here — on a VM PUBLIC_ORIGIN is https, so :80 is a redirect to a name that
# resolves off this machine and :443 wants a certificate this container may still be acquiring.
# 2021 is routed nowhere: compose publishes 80 and 443 and no other port.

{$PUBLIC_ORIGIN:http://localhost}, http://localhost:2021 {
	encode zstd gzip

	# Everything the API owns, including the live screen's WebSocket. `reverse_proxy` passes an
	# upgrade through without being told to; the socket arrives here as an ordinary /api path
	# because the app builds its URL from window.location rather than from a configured host.
	handle /api/* {
		reverse_proxy server:3001
	}

	# The one page the API draws for a person rather than for a program, and therefore the one path
	# outside /api that must not fall through to the SPA. A consent started in the desktop shell
	# finishes in the person's own browser, which has no session for the app — so this page needs
	# none either, and index.html here would be the signed-out app it exists to avoid.
	handle /connected {
		reverse_proxy server:3001
	}

	# "Is this deployment serving", answered by the API, at the path every monitor already asks.
	# Without this block the fallback below answered it: measured 2026-09-06 on a customer VM,
	# `/health` from outside was index.html — 200, 1,790 bytes — and stayed 200 through a six-second
	# API outage, so the fleet monitor read a dead API as alive. With it, the API's JSON comes
	# through (503 when it is degraded), and an API that is not there is a 502 from here: a poller
	# that reads only the status code learns the truth either way. `/api/health` is the same answer
	# through the `/api/*` block above.
	handle /health {
		reverse_proxy server:3001
	}

	# Hashed filenames, so the bytes at one of these paths never change. A year is what lets a
	# returning person load the app without asking about a single asset.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# index.html is the one file whose name never changes and whose contents always do: it is what
	# names the hashed bundles. Cached, it pins somebody to the build they first visited — measured,
	# after a deploy the browser was still running a bundle that no longer existed in the image, and
	# the new feature was simply absent with nothing on screen to say so. A shipped update that
	# reaches nobody is the worst shape of all: it looks deployed from every side except the user's.
	#
	# Written as "everything that is not an asset" rather than as a list of pages, because the SPA
	# fallback serves index.html for paths no file matches — a matcher naming `/index.html` would
	# miss every deep link, which is most of the ways anybody arrives.
	@page not path /assets/* /api/*
	header @page Cache-Control "no-cache"

	# What every page and asset served FROM HERE carries (A8, 2026-09-10: there was nothing — no CSP,
	# no HSTS, no frame-ancestors — so the approval button could be framed by any page and pressed
	# through the frame, which is the one thing the boundary exists to stop). What this block proxies
	# carries the API's own (server/src/middleware/security.ts), and the matcher leaves it alone so
	# the two never double up.
	#
	# SCRIPTS: this origin, and inline — and no hash, on purpose. A sandboxed component (the admin
	# playground's preview, and the same component in a conversation) runs in an iframe whose
	# document is `srcdoc`, and a srcdoc document INHERITS this policy: measured 2026-09-13, with the
	# theme script named by hash the preview's own inline script was refused and the component drew
	# nothing. A hash would also switch `'unsafe-inline'` off, so there is none, and the theme script
	# runs as inline. `eval` stays refused — the one caller, Zod's probe, is switched off
	# (app/src/lib/zod-jitless.ts) — and no script loads from anywhere but here, in the app or in a
	# sandbox, which is also why a component cannot pull a library off a CDN.
	#
	# The image hosts are the three sign-in providers' avatars, and nothing else: a Bot's answer
	# cannot make this origin fetch an attacker's image. The WebSocket entries are this host spelled
	# out, for the engines that do not read `'self'` as covering `ws:`.
	@served not path /api/* /connected /health
	header @served {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://*.kakaocdn.net https://*.pstatic.net; font-src 'self' data:; connect-src 'self' wss://{http.request.hostport} ws://{http.request.hostport}; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	handle {
		root * /srv

		# The router runs in the browser, so a deep link asks for a path no file matches. Without
		# this line every reload anywhere but / is a 404 — and it is invisible in development,
		# where Vite does the same fallback on its own.
		try_files {path} /index.html

		file_server
	}
}

# People type www out of habit, and a name that resolves but cannot complete a TLS handshake reads
# as "the site is broken", not "use the other name" — measured as ERR_SSL_PROTOCOL_ERROR on the
# first real sign-in attempt. This block takes its own certificate and hands every request to the
# apex. A redirect rather than a second copy of the app, because the API's cookie origin is ONE
# string: an app served from two hosts is two origins to a browser, and the www copy would offer
# sign-in forever without ever holding a session.
{$PUBLIC_WWW_ORIGIN:http://www.localhost} {
	redir {$PUBLIC_ORIGIN:http://localhost}{uri} permanent
}
