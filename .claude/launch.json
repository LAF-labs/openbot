{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "server",
        "--env-file=../.env",
        "src/index.ts"
      ],
      "port": 3001
    },
    {
      "name": "bot",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd",
        "agent-bot",
        "--env-file=../.env",
        "src/index.ts"
      ],
      "port": 4200
    },
    {
      "name": "app",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd=app",
        "dev"
      ],
      "port": 3010
    }
  ]
}
