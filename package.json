{
  "name": "laf-agent",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "app",
    "server",
    "agent-bot",
    "agent-computer",
    "desktop"
  ],
  "overrides": {
    "lodash-es": "^4.17.23",
    "qs": "^6.16.0",
    "remend": "^1.3.1",
    "undici": "^7.29.0",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "build": "bun run generate:app-config && bun run --filter '*' build",
    "dev": "bun run generate:app-config && bun run --filter '*' --parallel dev",
    "generate:app-config": "bun --env-file=.env scripts/generate-app-config.ts",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "lint": "bunx biome lint .",
    "knip": "knip",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "test:ci": "bun scripts/test-ci.ts",
    "pretest": "bun run generate:app-config",
    "test:smoke": "LAF_SMOKE=1 bun test tests/smoke",
    "diagram": "bun scripts/architecture-diagram.ts",
    "eval:model": "bun --env-file=.env evals/run.ts",
    "eval:cache": "bun --env-file=.env evals/cache.ts",
    "eval:deferral": "bun --env-file=.env evals/deferral.ts",
    "eval:compaction": "bun --env-file=.env evals/compaction.ts",
    "eval:auto-review": "bun --env-file=.env evals/auto-review.ts",
    "eval:browse": "bun --env-file=.env evals/browse.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "knip": "6.38.0",
    "roughjs": "^4.6.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {}
}
